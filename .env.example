# ==================================
# Proof of Useful Work Token - Configuration
# ==================================

# ==================================
# API Configuration
# ==================================

# Server port
PORT=3000

# Anthropic API Key (required for agent worker)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Agent wallet address (receives tokens for completed work)
AGENT_WALLET=0x0000000000000000000000000000000000000000

# ==================================
# Worker Configuration
# ==================================

# How often the worker checks for new tasks (milliseconds)
WORKER_POLL_INTERVAL=5000

# ==================================
# Blockchain Configuration
# ==================================

# RPC URL for blockchain network
# Base Sepolia (testnet): https://sepolia.base.org
# Base Mainnet: https://mainnet.base.org
RPC_URL=https://sepolia.base.org

# Oracle private key (wallet that submits proofs on-chain)
# This should be the same wallet that deployed the contract
ORACLE_PRIVATE_KEY=0xYourPrivateKeyHere

# Deployed contract address (set after deployment)
CONTRACT_ADDRESS=

# Token mint rate: How many chain tokens per LLM compute token
# Example: 1 = 1 LLM token creates 1 chain token
MINT_RATE=1

# How often to submit proofs on-chain (milliseconds)
# Default: 60000 (1 minute)
PROOF_SUBMIT_INTERVAL=60000

# ==================================
# Optional: For contract verification
# ==================================

# BaseScan API Key (for contract verification)
# Get yours at: https://basescan.org/myapikey
BASESCAN_API_KEY=
